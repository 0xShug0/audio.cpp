  "dependencies": [],
  "options": {
    "request": [
      {
        "name": "language",
        "type": "string",
        "description": "Input language as an OWSM ISO 639-3 code, such as eng, jpn, or zho; auto detects it from the first window.",
        "required": false,
        "default": "eng"
      },
      {
        "name": "target_language",
        "type": "string",
        "description": "Optional OWSM translation target code. Omit for transcription.",
        "required": false
      },
      {
        "name": "return_timestamps",
        "type": "bool",
        "description": "Return OWSM utterance-level timestamp segments.",
        "required": false,
        "default": false
      },
      {
        "name": "condition_on_previous_text",
        "type": "bool",
        "description": "Condition each long-form chunk on the previous chunk transcript.",
        "required": false,
        "default": false
      },
      {
        "name": "beam_size",
        "type": "int",
        "description": "Decoder beam width; one selects greedy decoding.",
        "required": false,
        "min": 1,
        "max": 50002,
        "default": 1
      },
      {
        "name": "max_tokens",
        "type": "int",
        "description": "Maximum generated tokens per 30-second window; zero uses the model limit.",
        "required": false,
        "min": 0,
        "max": 374,
        "default": 0
      },
      {
        "name": "audio_chunk_mode",
        "type": "enum",
        "description": "Long-form audio chunking mode.",
        "values": [
          "auto",
          "fixed",
          "none"
        ],
        "required": false,
        "default": "auto"
      },
      {
        "name": "audio_chunk_duration_sec",
        "type": "float",
        "description": "Maximum duration of each audio window.",
        "required": false,
        "min": 0.2,
        "max": 30,
        "default": 30
      }
    ],
    "session": [
      {
        "name": "weight_type",
        "type": "enum",
        "description": "Matmul weight storage override.",
        "values": [
          "native",
          "f32",
          "f16",
          "bf16",
          "q8_0",
          "q4_0",
          "q4_1",
          "q5_0",
          "q5_1",
          "q2_k",
          "q3_k",
          "q4_k",
          "q5_k",
          "q6_k",
          "i8"
        ],
        "required": false,
        "default": "native"
      }
    ],
    "load": []
  },
  "runtime": {
    "tags": [
      "gguf",
      "cpu",
      "cuda",
      "vulkan"
    ]
  },
  "ui": {
