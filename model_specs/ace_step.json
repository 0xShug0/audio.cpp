      "download": {
        "kind": "huggingface_snapshot",
        "repo": "CaptainArni/audio.cpp-gguf"
      }
    },
    {
      "id": "ace_step_xl_sft_bf16",
      "display_name": "ACE-Step 1.5 XL SFT BF16 GGUF",
      "format": "gguf",
      "precision": "bf16",
