{
  "schema_version": 1,
  "family": "mossformer2",
  "display_name": "MossFormer2",
  "description": "MossFormer2 two-speaker separation at 16 kHz, speech enhancement and super-resolution at 48 kHz.",
  "category": "audio_tools",
  "status": "supported",
  "tasks": [
    "sep",
    "s2s"
  ],
  "modes": [
    "offline"
  ],
  "languages": [
    "language_agnostic"
  ],
  "capabilities": {
    "sep": [
      "stems"
    ],
    "s2s": [
      "audio_enhancement"
    ]
  },
  "runtime": {
    "tags": [
      "gguf"
    ]
  },
  "options": {
    "request": [
      {
        "name": "audio_chunk_duration_sec",
        "type": "float",
        "description": "Window duration; zero processes the whole input. SS defaults to 2 seconds. SE/SR default to whole-file inference up to 20 seconds and 4-second windows for longer input. SR windows round up to a vocoder hop.",
        "min": 0,
        "required": false
      },
      {
        "name": "audio_chunk_overlap_sec",
        "type": "float",
        "description": "Overlap between windows; must be nonnegative and smaller than the window. Defaults to 0.5 seconds for SS and one quarter of the window for SE/SR. Overlapping edges are trimmed, not averaged. Ignored for whole-file inference.",
        "min": 0,
        "required": false
      },
      {
        "name": "normalize_output",
        "type": "bool",
        "description": "Match output RMS to input. Defaults to true for SS and false for SE/SR, following ClearVoice.",
        "required": false
      }
    ],
    "session": [],
    "load": []
  },
  "package_defaults": {
    "download": {
      "kind": "huggingface_snapshot",
      "repo": "audio-cpp/audio.cpp-gguf",
      "revision": "main",
      "gated": false
    }
  },
  "packages": [
    {
      "id": "mossformer2_ss_16k_f32",
      "display_name": "MossFormer2 SS 16K F32",
      "default": true,
      "format": "gguf",
      "precision": "f32",
      "target_directory": "MossFormer2-GGUF",
      "files": [
        "MossFormer2-GGUF/mossformer2-ss-16k-f32.gguf"
      ],
      "strip_prefix": "MossFormer2-GGUF"
    },
    {
      "id": "mossformer2_ss_16k_f16",
      "display_name": "MossFormer2 SS 16K F16",
      "default": false,
      "format": "gguf",
      "precision": "f16",
      "target_directory": "MossFormer2-GGUF",
      "files": [
        "MossFormer2-GGUF/mossformer2-ss-16k-f16.gguf"
      ],
      "strip_prefix": "MossFormer2-GGUF"
    },
    {
      "id": "mossformer2_se_48k_f32",
      "display_name": "MossFormer2 Speech Enhancement 48K F32",
      "default": false,
      "format": "gguf",
      "precision": "f32",
      "target_directory": "MossFormer2-GGUF",
      "files": [
        "MossFormer2-GGUF/mossformer2-se-48k-f32.gguf"
      ],
      "strip_prefix": "MossFormer2-GGUF"
    },
    {
      "id": "mossformer2_sr_48k_f16",
      "display_name": "MossFormer2 Speech Super-Resolution 48K F16",
      "default": false,
      "format": "gguf",
      "precision": "f16",
      "target_directory": "MossFormer2-GGUF",
      "files": [
        "MossFormer2-GGUF/mossformer2-sr-48k-f16.gguf"
      ],
      "strip_prefix": "MossFormer2-GGUF"
    }
  ],
  "dependencies": [],
  "ui": {
    "tags": [
      "GGUF"
    ],
    "docs": [
      "docs/models/mossformer2.md"
    ],
    "recommended_package": "mossformer2_ss_16k_f32"
  },
  "sources": [
    {
      "format": "gguf",
      "roots": {
        "model": ".",
        "weights": "$gguf"
      },
      "files": {
        "config": "model:config.json"
      },
      "tensors": {
        "weights": {
          "source": "weights:",
          "prefix": "weights"
        }
      }
    }
  ]
}
