      "target_directory": "SoulX-Singer-GGUF",
      "files": [
        "SoulX-Singer-GGUF/soulx-singer-f16.gguf"
      ],
      "strip_prefix": "SoulX-Singer-GGUF"
    },
    {
      "id": "soulx_singer_svc_q8_0",
      "display_name": "SoulX-Singer SVC Q8_0",
      "default": false,
      "format": "gguf",
      "precision": "q8_0",
      "target_directory": "SoulX-Singer-SVC-GGUF",
      "files": [
        "SoulX-Singer-SVC-GGUF/soulx-singer-svc-q8_0.gguf"
      ],
      "strip_prefix": "SoulX-Singer-SVC-GGUF"
    },
    {
      "id": "soulx_singer_svc_f16",
      "display_name": "SoulX-Singer SVC F16",
      "default": false,
