{
  "schema_version": 1,
  "family": "ced",
  "display_name": "CED Audio Tagging",
  "description": "Consistent Ensemble Distillation ViT audio classifiers for 527 AudioSet sound categories.",
  "category": "speech_analysis",
  "status": "supported",
  "tasks": [
    "classify"
  ],
  "modes": [
    "offline"
  ],
  "languages": [
    "language_agnostic"
  ],
  "capabilities": {
    "classify": [
      "scores"
    ]
  },
  "runtime": {
    "tags": [
      "gguf"
    ]
  },
  "options": {
    "request": [
      {
        "name": "top_k",
        "type": "int",
        "description": "Number of highest-scoring AudioSet categories returned.",
        "required": false,
        "default": 10,
        "min": 1,
        "max": 527
      }
    ],
    "session": [
      {
        "name": "attention",
        "type": "enum",
        "description": "Attention implementation; auto selects a supported fast path.",
        "required": false,
        "default": "auto",
        "values": [
          "auto",
          "flash",
          "eager"
        ]
      },
      {
        "name": "weight_type",
        "type": "enum",
        "description": "Weight storage override; native preserves packaged tensor types.",
        "required": false,
        "default": "native",
        "preset": "weight_type_full"
      }
    ],
    "load": []
  },
  "package_defaults": {
    "download": {
      "kind": "huggingface_snapshot",
      "repo": "audio-cpp/audio.cpp-gguf",
      "revision": "main",
      "gated": false
    }
  },
  "packages": [
    {
      "id": "ced_tiny_f32",
      "display_name": "CED Tiny F32 GGUF",
      "format": "gguf",
      "precision": "f32",
      "default": true,
      "target_directory": "CED-GGUF",
      "files": [
        "CED-GGUF/ced-tiny-f32.gguf"
      ],
      "strip_prefix": "CED-GGUF"
    },
    {
      "id": "ced_mini_f32",
      "display_name": "CED Mini F32 GGUF",
      "format": "gguf",
      "precision": "f32",
      "target_directory": "CED-GGUF",
      "files": [
        "CED-GGUF/ced-mini-f32.gguf"
      ],
      "strip_prefix": "CED-GGUF"
    },
    {
      "id": "ced_small_f32",
      "display_name": "CED Small F32 GGUF",
      "format": "gguf",
      "precision": "f32",
      "target_directory": "CED-GGUF",
      "files": [
        "CED-GGUF/ced-small-f32.gguf"
      ],
      "strip_prefix": "CED-GGUF"
    },
    {
      "id": "ced_base_f32",
      "display_name": "CED Base F32 GGUF",
      "format": "gguf",
      "precision": "f32",
      "target_directory": "CED-GGUF",
      "files": [
        "CED-GGUF/ced-base-f32.gguf"
      ],
      "strip_prefix": "CED-GGUF"
    }
  ],
  "dependencies": [],
  "ui": {
    "recommended_package": "ced_tiny_f32",
    "tags": [
      "Classify",
      "GGUF"
    ],
    "docs": [
      "docs/models/ced.md"
    ]
  },
  "sources": [
    {
      "format": "gguf",
      "roots": {
        "model": ".",
        "weights": "$gguf"
      },
      "files": {
        "config": "model:config.json",
        "processor": "model:preprocessor_config.json"
      },
      "tensors": {
        "weights": "weights:"
      }
    },
    {
      "format": "safetensors",
      "roots": {
        "model": "."
      },
      "files": {
        "config": "model:config.json",
        "processor": "model:preprocessor_config.json"
      },
      "tensors": {
        "weights": "model:model.safetensors"
      }
    }
  ]
}
