{
  "schema_version": 1,
  "family": "smart_turn",
  "display_name": "Smart Turn v3.2",
  "description": "Audio-native conversational turn-completion detection using a Whisper-Tiny encoder and attention-pooling classifier.",
  "category": "audio_tools",
  "status": "supported",
  "tasks": [
    "turn"
  ],
  "modes": [
    "offline"
  ],
  "languages": [
    "auto"
  ],
  "capabilities": {
    "turn": [
      "turn_decision"
    ]
  },
  "runtime": {
    "tags": [
      "gguf"
    ]
  },
  "options": {
    "request": [
      {
        "name": "threshold",
        "type": "float",
        "description": "Completion probability threshold; a decision is complete only when probability exceeds this value.",
        "required": false,
        "default": 0.5,
        "min": 0,
        "max": 1
      }
    ],
    "session": [],
    "load": []
  },
  "package_defaults": {
    "download": {
      "kind": "huggingface_snapshot",
      "repo": "audio-cpp/audio.cpp-gguf",
      "revision": "main",
      "gated": false
    }
  },
  "packages": [
    {
      "id": "smart_turn_v3_2_f32",
      "display_name": "Smart Turn v3.2 F32 GGUF",
      "default": true,
      "format": "gguf",
      "precision": "f32",
      "target_directory": "Smart-Turn-v3-GGUF",
      "files": [
        "Smart-Turn-v3-GGUF/smart-turn-v3.2-f32.gguf"
      ],
      "strip_prefix": "Smart-Turn-v3-GGUF"
    }
  ],
  "dependencies": [],
  "ui": {
    "tags": [
      "GGUF"
    ],
    "docs": [
      "docs/models/smart_turn.md"
    ],
    "recommended_package": "smart_turn_v3_2_f32"
  },
  "sources": [
    {
      "format": "gguf",
      "roots": {
        "model": ".",
        "weights": "$gguf"
      },
      "tensors": {
        "weights": {
          "source": "weights:",
          "prefix": "weights"
        }
      }
    }
  ]
}
