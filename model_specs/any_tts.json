{
  "family": "any_tts",
  "schema_version": 1,
  "display_name": "Any TTS Voice Clone",
  "description": "Compose an offline TTS model with Tone Color VC using in-memory audio.",
  "category": "tts",
  "status": "experimental",
  "tasks": [
    "tts",
    "clone"
  ],
  "modes": [
    "offline",
    "streaming"
  ],
  "languages": [
    "multilingual"
  ],
  "capabilities": {
    "tts": [
      "speaker_reference"
    ],
    "clone": [
      "speaker_reference"
    ]
  },
  "runtime": {
    "tags": []
  },
  "options": {
    "request": [
      {
        "name": "text_chunk_size",
        "type": "int",
        "required": false,
        "default": 240,
        "min": 1,
        "description": "Text chunk budget for incremental synthesis and conversion."
      },
      {
        "name": "text_chunk_mode",
        "type": "string",
        "required": false,
        "default": "default",
        "description": "Framework text chunking mode."
      },
      {
        "name": "vc_temperature",
        "type": "float",
        "required": false,
        "default": 0.3,
        "min": 0,
        "description": "Tone Color VC posterior noise scale."
      },
      {
        "name": "vc_seed",
        "type": "int",
        "required": false,
        "default": 1234,
        "min": -1,
        "description": "Tone Color VC seed; -1 chooses a random seed."
      }
    ],
    "session": [],
    "load": []
  },
  "packages": [],
  "dependencies": [],
  "ui": {
    "tags": [
      "TTS",
      "Voice cloning"
    ],
    "docs": [
      "docs/models/any_tts.md"
    ]
  },
  "sources": []
}
