        "name": "instruct",
        "type": "string",
        "default": "describe the audio",
        "required": false,
        "description": "Question or instruction about the input audio."
      },
      {
        "name": "max_tokens",
        "type": "int",
        "min": 1,
        "max": 512,
        "default": 100,
        "required": false,
        "description": "Maximum response tokens."
      }
    ],
    "session": [],
    "load": []
