{
  "schema_version": 1,
  "family": "samsone",
  "display_name": "SAMSONE",
  "description": "Compact audio-language models for audio captioning, question answering, and sound, music, and speech understanding.",
  "category": "asr",
  "status": "supported",
  "tasks": [
    "asr"
  ],
  "modes": [
    "offline"
