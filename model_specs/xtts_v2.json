{
  "schema_version": 1,
  "family": "xtts_v2",
  "display_name": "XTTS v2",
  "description": "Coqui XTTS v2 cross-lingual text-to-speech with voice cloning: GPT-2 mel-code generator, perceiver conditioning resampler, HiFi-GAN decoder, and speaker encoder.",
  "category": "tts",
  "status": "community",
