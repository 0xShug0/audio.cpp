  "options": {
    "request": [
      {
        "name": "language",
        "type": "string",
        "description": "Source language for text conditioning (e.g. 'en'); also selects tokenizer normalization.",
        "required": false,
        "default": "en"
      },
      {
        "name": "temperature",
        "type": "float",
        "description": "AR sampling temperature; official default 0.75.",
        "required": false,
        "min": 0.0,
        "default": 0.75
      },
      {
        "name": "top_k",
        "type": "int",
        "description": "AR top-k sampling; official default 50.",
        "required": false,
        "min": 0,
        "default": 50
      },
      {
        "name": "top_p",
        "type": "float",
        "description": "AR nucleus sampling threshold; official default 0.85.",
        "required": false,
        "min": 0.0,
        "max": 1.0,
        "default": 0.85
      },
      {
        "name": "repetition_penalty",
        "type": "float",
        "description": "AR repetition penalty; official default 10.0.",
        "required": false,
        "min": 1.0,
        "default": 10.0
      },
      {
        "name": "max_mel_tokens",
        "type": "int",
        "description": "Maximum mel codes to generate; official default 605.",
        "required": false,
        "min": 1,
        "default": 605
      }
    ],
    "session": [],
    "load": []
  },
  "runtime": {
    "tags": [
      "gguf"
    ]
  },
