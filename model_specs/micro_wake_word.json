{
  "schema_version": 1,
  "family": "micro_wake_word",
  "display_name": "microWakeWord",
  "description": "Streaming wake-word detection for trained microWakeWord MixedNet TFLite models converted to GGUF.",
  "category": "audio_tools",
  "status": "experimental",
  "tasks": [
    "wake_word"
  ],
  "modes": [
    "offline",
    "streaming"
  ],
  "languages": [
    "model_dependent"
  ],
  "capabilities": {
    "wake_word": [
      "speech_segments",
      "stream_events"
    ]
  },
  "runtime": {
    "tags": [
      "gguf",
      "stream"
    ]
  },
  "options": {
    "request": [
      {
        "name": "threshold",
        "type": "float",
        "description": "Override the converted model manifest's wake-word probability cutoff.",
        "required": false,
        "min": 0,
        "max": 1
      },
      {
        "name": "sliding_window_size",
        "type": "int",
        "description": "Override the converted model manifest's prediction smoothing window.",
        "required": false,
        "min": 1
      }
    ],
    "session": [],
    "load": []
  },
  "package_defaults": {
    "download": {
      "kind": "huggingface_snapshot",
      "repo": "audio-cpp/audio.cpp-gguf",
      "revision": "main",
      "gated": false
    }
  },
  "packages": [
    {
      "id": "micro_wake_word_okay_nabu_f32",
      "display_name": "microWakeWord Okay Nabu GGUF F32",
      "default": true,
      "format": "gguf",
      "precision": "f32",
      "target_directory": "MicroWakeWord-GGUF",
      "files": [
        "MicroWakeWord-GGUF/micro-wake-word-okay-nabu-f32.gguf"
      ],
      "strip_prefix": "MicroWakeWord-GGUF"
    }
  ],
  "dependencies": [],
  "ui": {
    "tags": [
      "Wake Word",
      "GGUF",
      "Stream"
    ],
    "docs": [
      "docs/models/micro_wake_word.md"
    ],
    "recommended_package": "micro_wake_word_okay_nabu_f32"
  },
  "sources": [
    {
      "format": "gguf",
      "roots": {
        "model": ".",
        "weights": "$gguf"
      },
      "files": {
        "config": "model:config.json"
      },
      "tensors": {
        "weights": {
          "source": "weights:",
          "prefix": "weights"
        }
      }
    },
    {
      "format": "safetensors",
      "roots": {
        "model": "."
      },
      "files": {
        "config": "model:config.json"
      },
      "tensors": {
        "weights": "model:model.safetensors"
      }
    }
  ]
}
