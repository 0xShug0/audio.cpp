# Windows command scripts should use CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Pinned upstream Unicode sources; keep their bytes stable and collapse them in PRs.
external/utf8proc/* text eol=lf linguist-vendored
# The upstream-generated table contains intentional trailing spaces.
external/utf8proc/utf8proc_data.c -whitespace linguist-generated

# Binary, media, model, and archive files.
*.7z binary
*.bin binary
*.bmp binary
*.dll binary
*.dylib binary
*.exe binary
*.flac binary
*.gguf binary
*.gif binary
*.ico binary
*.jpeg binary
*.jpg binary
*.mp3 binary
*.onnx binary
*.png binary
*.safetensors binary
*.so binary
*.wav binary
*.webp binary
*.zip binary
