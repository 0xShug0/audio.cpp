// SPDX-License-Identifier: MIT
amdgpu.target<gfx11-generic> @ggml_pad_target {subgroup_size = 64}
config.decl @ggml.pad.ne0 : %value: index where [range(%value, 1, 1073741824)]
config.decl @ggml.pad.ne1 : %value: index where [range(%value, 1, 1073741824)]
config.decl @ggml.pad.ne2 : %value: index where [range(%value, 1, 1073741824)]
config.decl @ggml.pad.src_ne0 : %value: index where [range(%value, 1, 1073741824)]
config.decl @ggml.pad.src_ne1 : %value: index where [range(%value, 1, 1073741824)]
config.decl @ggml.pad.src_ne2 : %value: index where [range(%value, 1, 1073741824)]
config.decl @ggml.pad.src_ne3 : %value: index where [range(%value, 1, 1073741824)]
config.decl @ggml.pad.left0 : %value: index where [range(%value, 0, 2147483649)]
config.decl @ggml.pad.left1 : %value: index where [range(%value, 0, 2147483649)]
config.decl @ggml.pad.left2 : %value: index where [range(%value, 0, 2147483649)]
config.decl @ggml.pad.left3 : %value: index where [range(%value, 0, 2147483649)]
config.decl @ggml.pad.crop0 : %value: index where [range(%value, 0, 2147483649)]
config.decl @ggml.pad.crop1 : %value: index where [range(%value, 0, 2147483649)]
config.decl @ggml.pad.crop2 : %value: index where [range(%value, 0, 2147483649)]
config.decl @ggml.pad.crop3 : %value: index where [range(%value, 0, 2147483649)]
config.decl @ggml.pad.shift0 : %value: index where [range(%value, 0, 1073741824)]
config.decl @ggml.pad.shift1 : %value: index where [range(%value, 0, 1073741824)]
config.decl @ggml.pad.shift2 : %value: index where [range(%value, 0, 1073741824)]
config.decl @ggml.pad.shift3 : %value: index where [range(%value, 0, 1073741824)]
config.decl @ggml.pad.circular : %value: index where [range(%value, 0, 2)]
config.decl @ggml.pad.stride0 : %value: index where [range(%value, 1, 1073741824)]
config.decl @ggml.pad.stride1 : %value: index where [range(%value, 1, 1073741824)]
config.decl @ggml.pad.stride2 : %value: index where [range(%value, 1, 1073741824)]
config.decl @ggml.pad.stride3 : %value: index where [range(%value, 1, 1073741824)]
kernel.def target(@ggml_pad_target) export("ggml_pad_f32") @ggml_pad_f32(%element_count: index, %source_span: index) {
  %one = index.constant 1 : index
  %threads = index.constant 256 : index
  %rounding = index.constant 255 : index
  %rounded = index.add %element_count, %rounding : index
  %groups = index.div %rounded, %threads : index
  kernel.launch.config workgroups(%groups, %one, %one) workgroup_size(%threads, %one, %one) : index
} launch(%element_count: index, %source_span: index, %input: buffer, %output: buffer) {
  %count = index.assume %element_count [range(%element_count, 1, 1073741824)] : index
  %span = index.assume %source_span [range(%source_span, 1, 1073741824)] : index
  %group = kernel.workgroup.id<x> : index
  %thread = kernel.workitem.id<x> : index
  %threads = index.constant 256 : index
  %offset = index.constant 0 : offset
  %base = index.mul %group, %threads : index
  %linear = index.add %base, %thread : index
  %valid = index.cmp ult, %linear, %count : index
  %iv = buffer.view %input[%offset] : buffer -> view<[%span]xf32>
  %ov = buffer.view %output[%offset] : buffer -> view<[%count]xf32>
  %ne0 = config.get @ggml.pad.ne0 : index
  %ne1 = config.get @ggml.pad.ne1 : index
  %ne2 = config.get @ggml.pad.ne2 : index
  %src_ne0 = config.get @ggml.pad.src_ne0 : index
  %src_ne1 = config.get @ggml.pad.src_ne1 : index
  %src_ne2 = config.get @ggml.pad.src_ne2 : index
  %src_ne3 = config.get @ggml.pad.src_ne3 : index
  %stride0 = config.get @ggml.pad.stride0 : index
  %stride1 = config.get @ggml.pad.stride1 : index
  %stride2 = config.get @ggml.pad.stride2 : index
  %stride3 = config.get @ggml.pad.stride3 : index
  %zero_index = index.constant 0 : index
  %zero_value = scalar.constant 0.0 : f32
  %circular_mode = config.get @ggml.pad.circular : index
  %circular = index.cmp ne, %circular_mode, %zero_index : index
  %left0 = config.get @ggml.pad.left0 : index
  %left1 = config.get @ggml.pad.left1 : index
  %left2 = config.get @ggml.pad.left2 : index
  %left3 = config.get @ggml.pad.left3 : index
  %crop0 = config.get @ggml.pad.crop0 : index
  %crop1 = config.get @ggml.pad.crop1 : index
  %crop2 = config.get @ggml.pad.crop2 : index
  %crop3 = config.get @ggml.pad.crop3 : index
  %shift0 = config.get @ggml.pad.shift0 : index
  %shift1 = config.get @ggml.pad.shift1 : index
  %shift2 = config.get @ggml.pad.shift2 : index
  %shift3 = config.get @ggml.pad.shift3 : index
  scf.if %valid {
    %i0 = index.rem %linear, %ne0 : index
    %q0 = index.div %linear, %ne0 : index
    %i1 = index.rem %q0, %ne1 : index
    %q1 = index.div %q0, %ne1 : index
    %i2 = index.rem %q1, %ne2 : index
    %i3 = index.div %q1, %ne2 : index
    %r0 = scf.if %circular -> (index) {
      %mod0 = index.rem %i0, %src_ne0 : index
      %shifted0 = index.add %mod0, %shift0 : index
      %wrapped0 = index.rem %shifted0, %src_ne0 : index
      scf.yield %wrapped0 : index
    } else {
      %cropped0 = index.add %i0, %crop0 : index
      %coord0 = index.sub %cropped0, %left0 : index
      scf.yield %coord0 : index
    }
    %inside0 = index.cmp ult, %r0, %src_ne0 : index
    %r1 = scf.if %circular -> (index) {
      %mod1 = index.rem %i1, %src_ne1 : index
      %shifted1 = index.add %mod1, %shift1 : index
      %wrapped1 = index.rem %shifted1, %src_ne1 : index
      scf.yield %wrapped1 : index
    } else {
      %cropped1 = index.add %i1, %crop1 : index
      %coord1 = index.sub %cropped1, %left1 : index
      scf.yield %coord1 : index
    }
    %inside1 = index.cmp ult, %r1, %src_ne1 : index
    %r2 = scf.if %circular -> (index) {
      %mod2 = index.rem %i2, %src_ne2 : index
      %shifted2 = index.add %mod2, %shift2 : index
      %wrapped2 = index.rem %shifted2, %src_ne2 : index
      scf.yield %wrapped2 : index
    } else {
      %cropped2 = index.add %i2, %crop2 : index
      %coord2 = index.sub %cropped2, %left2 : index
      scf.yield %coord2 : index
    }
    %inside2 = index.cmp ult, %r2, %src_ne2 : index
    %r3 = scf.if %circular -> (index) {
      %mod3 = index.rem %i3, %src_ne3 : index
      %shifted3 = index.add %mod3, %shift3 : index
      %wrapped3 = index.rem %shifted3, %src_ne3 : index
      scf.yield %wrapped3 : index
    } else {
      %cropped3 = index.add %i3, %crop3 : index
      %coord3 = index.sub %cropped3, %left3 : index
      scf.yield %coord3 : index
    }
    %inside3 = index.cmp ult, %r3, %src_ne3 : index
    %inside01 = scalar.andi %inside0, %inside1 : i1
    %inside23 = scalar.andi %inside2, %inside3 : i1
    %inside = scalar.andi %inside01, %inside23 : i1
    // Load only inside the source; padding threads must never dereference it.
    %value = scf.if %inside -> (f32) {
      %b0 = index.mul %r0, %stride0 : index
      %b1 = index.mul %r1, %stride1 : index
      %b2 = index.mul %r2, %stride2 : index
      %b3 = index.mul %r3, %stride3 : index
      %b01 = index.add %b0, %b1 : index
      %b23 = index.add %b2, %b3 : index
      %src0 = index.add %b01, %b23 : index
      %src = index.assume %src0 [lt(%src0, %span)] : index
      %loaded = view.load %iv[%src] : view<[%span]xf32> -> f32
      scf.yield %loaded : f32
    } else {
      scf.yield %zero_value : f32
    }
    %dst = index.assume %linear [lt(%linear, %count)] : index
    view.store %value, %ov[%dst] : f32, view<[%count]xf32>
  }
  kernel.return
}
